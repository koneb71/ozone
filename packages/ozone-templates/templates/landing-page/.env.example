# Copy to .env to change how Docker Compose runs the app on this machine.

# Host port the app is published on: http://localhost:<port>
OZONE_APP_PORT=3000

# User and group the app container runs as. Use your own (`id -u`, `id -g`)
# so the files it writes into this folder stay editable.
OZONE_UID=1000
OZONE_GID=1000

# Set to 1 when file changes are not picked up (bind mounts on macOS and Windows).
OZONE_WATCH_POLL=0
