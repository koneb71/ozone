# Copy to .env to change how Docker Compose runs the service on this machine.

# Host port the service is published on: http://localhost:<port>
OZONE_APP_PORT=3000

# User and group the container runs as. Use your own (`id -u`, `id -g`)
# so the files it writes into this folder stay editable.
OZONE_UID=1000
OZONE_GID=1000
