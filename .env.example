# Optional settings for building Ozone from source. Copy to `.env` or `.env.local`.
# Do not add server-side secrets to this file.

# Signed macOS builds: the Apple team and the app's provisioning profile, which grants the
# in-app browser its passkey entitlements.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
